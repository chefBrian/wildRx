rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /medications/{id} {
      allow read: if true;
      // schemaVersion 2 is written only by admin builds that keep bottle `routes`; older builds
      // would silently strip them, so their medication saves are rejected.
      allow create, update: if request.auth != null
        && request.resource.data.doseUnit in ['mg', 'IU', 'ml']
        && request.resource.data.concentrations is list
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 2;
      allow delete: if request.auth != null;
    }
    match /species/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dosingRules/{id} {
      allow read: if true;
      // The doc id must be `${medicationId}__${target.type}-${target.value}__${route}`
      // (src/domain/ruleId.ts). Rejects random-UUID writes from old admin builds.
      // Only stored DosingRule fields (no UI-only `source`, no old-shape fields).
      allow create, update: if request.auth != null
        && request.resource.data.dosePerKg is map
        && !request.resource.data.keys().hasAny(['mgPerKg', 'maxSingleDoseMg'])
        && request.resource.data.keys().hasOnly(['medicationId', 'target', 'dosePerKg', 'route',
             'frequency', 'durationDays', 'maxSingleDose', 'contraindications', 'notes',
             'updatedAt', 'updatedBy'])
        && id == request.resource.data.medicationId + '__'
             + request.resource.data.target.type + '-' + request.resource.data.target.value
             + '__' + request.resource.data.route;
      allow delete: if request.auth != null;
    }
  }
}
